# --- Core ---
FLASK_ENV=development
SECRET_KEY=change-me-in-production-to-a-long-random-string
# In prod set the real apex, e.g. paulux.app. CORS-allowed origins derive from
# this. When the SPA is on Vercel and the API on its own host, the API's Host
# carries no tenant — the SPA sends X-Tenant-Slug instead (see app/tenancy.py).
APP_BASE_DOMAIN=lvh.me
# Root/apex origin of the SPA (no tenant subdomain)
FRONTEND_ORIGIN=http://lvh.me:5173

# --- Database (Postgres) ---
# psycopg v3 URL
DATABASE_URL=postgresql+psycopg://paulux:paulux@localhost:5432/paulux

# --- Sessions / cookies ---
# Cookie is scoped to .<APP_BASE_DOMAIN> so it works across tenant subdomains.
SESSION_COOKIE_NAME=paulux_session
SESSION_MAX_DURATION_DAYS=30
SESSION_REFRESH_THRESHOLD_DAYS=15
# Set false only for local http; true in production (https)
SECURE_COOKIES=false

# --- Rate limiting / cache / queue backend ---
REDIS_URL=redis://localhost:6379/0

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=INFO

# --- Encryption key for per-tenant secrets (Paystack keys, etc.) ---
# 32-byte urlsafe base64 key (Fernet). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=

# --- Notifications / jobs (Phase 3) ---
# Backends auto-resolve: memory (testing), console (dev), resend/arkesel (prod).
EMAIL_BACKEND=
SMS_BACKEND=
RESEND_API_KEY=
EMAIL_FROM=Paulux <bookings@paulux.app>
ARKESEL_API_KEY=
ARKESEL_SENDER=Paulux
# Celery broker/result (Redis in prod). Unset in dev => tasks run eagerly.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
