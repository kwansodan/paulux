# Base domain for tenant subdomains (must match backend APP_BASE_DOMAIN)
VITE_BASE_DOMAIN=lvh.me
# Optional explicit API base URL. If unset, the client targets
# http://<current-host>:5000 in dev and same-origin in production.
VITE_API_BASE_URL=

# Platform enquiry button (apex marketing site only). Leave blank to hide.
# WhatsApp: full number incl. country code, digits only (e.g. 233201234567).
VITE_PLATFORM_WHATSAPP=
# Instagram: handle without the @ (e.g. paulux.app).
VITE_PLATFORM_INSTAGRAM=
