# Chatwoot Live Chat Integration
# Get your website token from Chatwoot Settings -> Inboxes -> Website Channel
VITE_CHATWOOT_WEBSITE_TOKEN=Awys7gWzgZif6qbf8Eu2hcXU
# Chatwoot Base URL (defaults to https://app.chatwoot.com if self-hosting Chatwoot)
VITE_CHATWOOT_BASE_URL=https://app.chatwoot.com

# Direct WhatsApp & Instagram Contact
# WhatsApp: full number incl. country code, digits only (e.g. 233201234567)
VITE_PLATFORM_WHATSAPP=
# Instagram: handle without the @ (e.g. paulux.app)
VITE_PLATFORM_INSTAGRAM=

# Serverless Lead Notifications (Vercel Environment Variables)
RESEND_API_KEY=
OPS_EMAIL=
ARKESEL_API_KEY=
OPS_PHONE=
ARKESEL_SENDER_ID=Paulux

