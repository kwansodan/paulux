# --- Paulux backend stack env (copy to infra/.env) ---
#
# This VPS serves api.<APP_BASE_DOMAIN> + files.<APP_BASE_DOMAIN>.
# The SPA is on Vercel at <APP_BASE_DOMAIN> and *.<APP_BASE_DOMAIN>.

# Domain: tenants live at <slug>.<APP_BASE_DOMAIN>. CORS derives the allowed
# origins from this, so it must be the real apex the SPA is served from —
# a *.vercel.app URL will NOT work (cookies would be third-party).
APP_BASE_DOMAIN=paulux.app
FRONTEND_ORIGIN=https://paulux.app
FLASK_ENV=production
SECRET_KEY=change-me-to-a-long-random-string
SECURE_COOKIES=true

# TLS — HTTP-01 for two single hostnames; no DNS plugin or wildcard needed.
ACME_EMAIL=ops@paulux.app

# Database
POSTGRES_USER=paulux
POSTGRES_PASSWORD=change-me
POSTGRES_DB=paulux
DATABASE_URL=postgresql+psycopg://paulux:change-me@db:5432/paulux

# Redis (rate limiting + Celery broker)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Per-tenant secret encryption (Fernet key)
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=

# Notifications
EMAIL_BACKEND=resend
SMS_BACKEND=arkesel
RESEND_API_KEY=
EMAIL_FROM=Paulux <bookings@paulux.app>
# Standalone/own-domain enquiries are emailed here. Empty => leads saved, no email.
OPS_EMAIL=
ARKESEL_API_KEY=
ARKESEL_SENDER=Paulux

# Object storage (MinIO)
# MINIO_ENDPOINT must be the PUBLIC host, not minio:9000 — presigned URLs are
# signed against it and the browser PUTs straight there, so the signature has to
# match the Host the browser sends. Presigning is pure local crypto (no network
# call), so the API never needs the internal address. Caddy preserves Host when
# proxying files.<domain> -> minio:9000, so the signature validates.
MINIO_ROOT_USER=paulux
MINIO_ROOT_PASSWORD=change-me
MINIO_ENDPOINT=files.paulux.app
MINIO_ACCESS_KEY=paulux
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=paulux-uploads
MINIO_SECURE=true
MINIO_PUBLIC_URL=https://files.paulux.app

# Platform billing webhook secret
BILLING_WEBHOOK_SECRET=

# Observability
SENTRY_DSN=
LOG_LEVEL=INFO
